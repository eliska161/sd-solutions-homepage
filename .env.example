# Resend API key (add the same value in Vercel → Project → Settings → Environment Variables)
RESEND_API_KEY=re_xxxxxxxx

# Public repair portal (serviceordre)
NEXT_PUBLIC_REPAIR_PORTAL_URL=https://repair.sd-solutions.org

# Optional. Same value on the homepage (Vercel) and repair app (Fly).
# If unset, the locker API is open but only answers with ticket + device for a valid number.
KIOSK_API_SECRET=
