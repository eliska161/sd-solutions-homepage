# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

